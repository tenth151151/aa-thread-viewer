# git の core.autocrlf の設定に関係なく、テキストファイルをリポジトリに LF で入れる。
* text=auto
# シェルスクリプトはコンテナ内の bash で実行するので、OSに関係なく LF に固定する
*.sh text eol=lf
# gradlew はコンテナ内の bash で実行するので、ホストの core.autocrlf に関係なく LF に固定する。
gradlew text eol=lf
# Windows のバッチファイルは CRLF でないと動かないことがあるので、CRLF に固定する。
*.bat text eol=crlf
# versions.properties は Dockerfile と CI が grep / cut で読むので、CRLF だと値の末尾に \r が付いて壊れる。LF に固定する。
versions.properties text eol=lf
