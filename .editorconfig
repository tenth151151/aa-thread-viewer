root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# .gitattributes で CRLF に固定している。
[*.bat]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

# 行末の空白 2 つは Markdown の改行なので、削除しない。
[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
# @Composable 関数は大文字で始まる名前にする慣習なので、関数名のルールの対象外にする。
ktlint_function_naming_ignore_when_annotated_with = Composable
