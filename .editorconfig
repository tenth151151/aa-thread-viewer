root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# .gitattributes で CRLF に固定している。
[*.{bat,ps1}]
end_of_line = crlf

# Windows PowerShell 5.1 は、BOM のない UTF-8 を ANSI として読むため、BOM を付ける。
[*.ps1]
charset = utf-8-bom

[*.{yml,yaml}]
indent_size = 2

# 行末の空白 2 つは Markdown の改行なので、削除しない。
[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
# @Composable 関数は大文字で始まる名前にする慣習なので、関数名のルールの対象外にする。
ktlint_function_naming_ignore_when_annotated_with = Composable
