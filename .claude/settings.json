{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/bin/statusline.sh\""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(command -v jq >/dev/null 2>&1 && jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' 2>/dev/null); bash \"$CLAUDE_PROJECT_DIR/bin/check-fullwidth-parens.sh\" ${f:+\"$f\"} || exit 2"
          }
        ]
      }
    ]
  },
  "agent": "supervisor",
  "advisorModel": "opus",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *--approve*)",
      "Bash(gh pr review *-a)",
      "Bash(gh pr review *-a *)",
      "Bash(gh api graphql*)",
      "Bash(gh api * graphql*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(gh api *-X*POST*)",
      "Bash(gh api *--method*POST*)",
      "Bash(gh api *-X*post*)",
      "Bash(gh api *--method*post*)",
      "Bash(gh api *-X*PUT*)",
      "Bash(gh api *--method*PUT*)",
      "Bash(gh api *-X*put*)",
      "Bash(gh api *--method*put*)",
      "Bash(gh api *-X*PATCH*)",
      "Bash(gh api *--method*PATCH*)",
      "Bash(gh api *-X*patch*)",
      "Bash(gh api *--method*patch*)",
      "Bash(gh api *-X*DELETE*)",
      "Bash(gh api *--method*DELETE*)",
      "Bash(gh api *-X*delete*)",
      "Bash(gh api *--method*delete*)"
    ]
  }
}
