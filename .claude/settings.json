{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/bin/statusline.sh\""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(command -v jq >/dev/null 2>&1 && jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' 2>/dev/null); bash \"$CLAUDE_PROJECT_DIR/bin/check-fullwidth-parens.sh\" ${f:+\"$f\"} || exit 2"
          }
        ]
      }
    ]
  },
  "agent": "supervisor",
  "advisorModel": "opus",
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills",
        "ref": "v1.3.1"
      },
      "autoUpdate": false
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "permissions": {
    "ask": [
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr review *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh issue lock *)",
      "Bash(gh issue unlock *)",
      "Bash(gh issue pin *)",
      "Bash(gh issue unpin *)",
      "Bash(gh issue develop *)",
      "Bash(gh label create *)",
      "Bash(gh label edit *)",
      "Bash(gh label delete *)",
      "Bash(gh -R *)",
      "Bash(gh --repo *)"
    ],
    "deny": [
      "Skill(mattpocock-skills:tdd)",
      "Skill(mattpocock-skills:tdd *)",
      "Skill(mattpocock-skills:code-review)",
      "Skill(mattpocock-skills:code-review *)",
      "Skill(mattpocock-skills:pr)",
      "Skill(mattpocock-skills:pr *)",
      "Skill(mattpocock-skills:wizard)",
      "Skill(mattpocock-skills:wizard *)",
      "Skill(mattpocock-skills:writing-for-agents)",
      "Skill(mattpocock-skills:writing-for-agents *)",
      "Skill(mattpocock-skills:implement)",
      "Skill(mattpocock-skills:implement *)",
      "Skill(mattpocock-skills:implement-spec)",
      "Skill(mattpocock-skills:implement-spec *)",
      "Skill(mattpocock-skills:setup-matt-pocock-skills)",
      "Skill(mattpocock-skills:setup-matt-pocock-skills *)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *--approve*)",
      "Bash(gh pr review *-a)",
      "Bash(gh pr review *-a *)",
      "Bash(gh api graphql*)",
      "Bash(gh api * graphql*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(gh api *-X*POST*)",
      "Bash(gh api *--method*POST*)",
      "Bash(gh api *-X*post*)",
      "Bash(gh api *--method*post*)",
      "Bash(gh api *-X*PUT*)",
      "Bash(gh api *--method*PUT*)",
      "Bash(gh api *-X*put*)",
      "Bash(gh api *--method*put*)",
      "Bash(gh api *-X*PATCH*)",
      "Bash(gh api *--method*PATCH*)",
      "Bash(gh api *-X*patch*)",
      "Bash(gh api *--method*patch*)",
      "Bash(gh api *-X*DELETE*)",
      "Bash(gh api *--method*DELETE*)",
      "Bash(gh api *-X*delete*)",
      "Bash(gh api *--method*delete*)"
    ]
  }
}
