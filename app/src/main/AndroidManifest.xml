<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        今は保存するデータがないため、allowBackup="false" にしてバックアップを無効にしている。
        あとで true にしても安全なように、Android 11 以前 (fullBackupContent) と 12 以降 (dataExtractionRules) の両方のルールで、全てを対象外にしている。
        データを保存するようになったら、この方針を見直す。見直すときは、backup_rules.xml と data_extraction_rules.xml の両方を直す。
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AAThreadViewer">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
